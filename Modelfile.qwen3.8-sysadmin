FROM qwen3.8:27b-mlx

# 64K context (~4GB KV cache on Qwen3.8's hybrid DeltaNet architecture)
PARAMETER num_ctx 65536

# Deterministic, syntax-safe sampling for CLI/YAML/Bash
PARAMETER temperature 0.2
PARAMETER min_p 0.08
PARAMETER top_k 20
PARAMETER top_p 0.90

# Disable repeat_penalty so config files, paths, and YAML keys aren't mutated
PARAMETER repeat_penalty 1.0
